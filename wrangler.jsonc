{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roadster-thrust-lab",
  "main": "worker/entry.py",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "roadstersim.pixelated.website",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}